# Replace both values before starting the service.
UNIFIED_API_KEY=replace-with-a-long-random-client-key
ADMIN_KEY=replace-with-a-long-random-admin-key
SECURE_COOKIE=false

# Optional HTTP(S) proxy for Google / Antigravity; never put account tokens here.
ANTIGRAVITY_PROXY=
UNIFIED_OUTBOUND_PROXY=
ANTIGRAVITY_CLIENT_ID=
ANTIGRAVITY_CLIENT_SECRET=
